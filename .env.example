# SST Alumni Connect — optional infrastructure settings.
# Every value has a safe default: `cp .env.example .env` is enough (the file may even be absent).
# Passwords for the database, Redis and object storage are generated automatically on first start
# (volume infra_secrets) and application settings are configured in the web interface.

# Port on this machine that serves the site
HTTP_PORT=8080

# production | development (development pre-fills the Mailpit mail catcher in the setup wizard)
ENVIRONMENT=production

# Optional profiles: dev = Mailpit mail catcher (http://localhost:8025), ops = Flower queue monitor (/flower/)
# COMPOSE_PROFILES=ops

# Capacity (see docker-compose.prod.yml). Keep replicas × workers × (pool + overflow) < max connections.
API_WORKERS=4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=256MB
LOG_LEVEL=INFO
